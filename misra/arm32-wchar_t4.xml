<?xml version="1.0"?>
<!--
Cortex-M / ARM EABI type sizes and signedness for cppcheck, matching what
arm-none-eabi-gcc actually reports for this target (verified via its own
predefined macros: __SIZEOF_WCHAR_T__=4, __CHAR_UNSIGNED__=1). Bundled here
rather than referenced from cppcheck's own install (path varies by OS/package
manager -- this file is cppcheck's own upstream arm32-wchar_t4.xml, copied
verbatim since it isn't exposed as a named --platform= builtin).
-->
<platform>
  <char_bit>8</char_bit>
  <default-sign>unsigned</default-sign>
  <sizeof>
    <bool>1</bool>
    <short>2</short>
    <int>4</int>
    <long>4</long>
    <long-long>8</long-long>
    <float>4</float>
    <double>8</double>
    <long-double>8</long-double>
    <pointer>4</pointer>
    <size_t>4</size_t>
    <wchar_t>4</wchar_t>
  </sizeof>
</platform>
