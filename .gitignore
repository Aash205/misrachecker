# Internal planning docs, not part of shipped toolchain
docs/superpowers/

# Cppcheck / clang-tidy caches
.cppcheck-build-dir/
.cache/
*.tidy-cache
*.dump

# cppcheck's cross-translation-unit analysis temp files (--enable=all
# writes these to cwd, e.g. `194526.ctu-info`; not always cleaned up if a
# run is killed/times out)
*.ctu-info

# Generated compile database / clangd fallback flags (machine-specific --
# paths depend on the local ARM toolchain's exact version/install location,
# regenerate via scripts/gen_compile_commands.sh / gen_compile_flags.sh)
compile_commands.json
compile_flags.txt

# STM32CubeIDE build artifacts (present if toolchain is tested inside a real CubeIDE project)
Debug/
Release/
.metadata/

# STM32Cube VS Code extension / CMake build output
build/
CMakeCache.txt
CMakeFiles/

# Python venv used to bootstrap pre-commit
.venv/

# lint.sh's self-downloaded misra.py fallback (used when no local cppcheck
# install ships a working addons/ folder) -- fetched from cppcheck's own
# upstream repo, not something to commit
misra/vendor-addons/
