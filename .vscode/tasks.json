{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MISRA: Check tools installed",
            "type": "process",
            "command": "${workspaceFolder}/scripts/check-tools.sh",
            "windows": {
                "command": "${workspaceFolder}\\scripts\\git-bash-resolve.cmd",
                "args": ["${workspaceFolder}/scripts/check-tools.sh"]
            },
            "runOptions": { "runOn": "folderOpen" },
            "presentation": { "reveal": "silent", "panel": "dedicated" },
            "problemMatcher": []
        },
        {
            "label": "MISRA: Lint",
            "type": "process",
            "command": "${workspaceFolder}/scripts/lint.sh",
            "windows": {
                "command": "${workspaceFolder}\\scripts\\git-bash-resolve.cmd",
                "args": ["${workspaceFolder}/scripts/lint.sh"]
            },
            "group": { "kind": "test", "isDefault": true },
            "runOptions": { "runOn": "folderOpen" },
            "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
            "problemMatcher": [
                {
                    "owner": "misra-cppcheck",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning|style|performance|portability|information|note):\\s+(.+?)\\s+\\[(.+)\\]$",
                        "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5, "code": 6
                    }
                }
            ]
        },
        {
            "label": "MISRA: Lint (current file)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/lint.sh",
            "windows": {
                "command": "${workspaceFolder}\\scripts\\git-bash-resolve.cmd",
                "args": ["${workspaceFolder}/scripts/lint.sh", "${file}"]
            },
            "args": ["${file}"],
            "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
            "problemMatcher": [
                {
                    "owner": "misra-cppcheck",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning|style|performance|portability|information|note):\\s+(.+?)\\s+\\[(.+)\\]$",
                        "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5, "code": 6
                    }
                }
            ]
        },
        {
            "label": "MISRA: Format fix",
            "type": "process",
            "command": "${workspaceFolder}/scripts/format.sh",
            "args": ["fix"],
            "windows": {
                "command": "${workspaceFolder}\\scripts\\git-bash-resolve.cmd",
                "args": ["${workspaceFolder}/scripts/format.sh", "fix"]
            },
            "problemMatcher": []
        },
        {
            "label": "MISRA: Format fix (current file)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/format.sh",
            "args": ["fix", "${file}"],
            "windows": {
                "command": "${workspaceFolder}\\scripts\\git-bash-resolve.cmd",
                "args": ["${workspaceFolder}/scripts/format.sh", "fix", "${file}"]
            },
            "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "MISRA: Install pre-commit hooks",
            "type": "process",
            "command": "${workspaceFolder}/scripts/install-hooks.sh",
            "windows": {
                "command": "${workspaceFolder}\\scripts\\git-bash-resolve.cmd",
                "args": ["${workspaceFolder}/scripts/install-hooks.sh"]
            },
            "problemMatcher": []
        },
        {
            "label": "MISRA: Regen compile_commands.json",
            "type": "process",
            "command": "${workspaceFolder}/scripts/gen_compile_commands.sh",
            "args": ["${input:cubeideProjectDir}"],
            "windows": {
                "command": "${workspaceFolder}\\scripts\\git-bash-resolve.cmd",
                "args": ["${workspaceFolder}/scripts/gen_compile_commands.sh", "${input:cubeideProjectDir}"]
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "cubeideProjectDir",
            "type": "promptString",
            "description": "Project dir to scan (almost always repo root)",
            "default": "."
        }
    ]
}
